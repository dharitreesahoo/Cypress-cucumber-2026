{
  "name": "cypress",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "cy:run": "cypress run",
    "report": "node cucumber-report.js",
    "smoke:test": "cypress run --env tags=\"@smoke\"",
    "regression:test": "cypress run --env tags=\"@regression\"",
    "smoke": "npm run smoke:test && npm run report",
    "regression": "npm run regression:test && npm run report",
    "clean:reports": "rimraf cypress/cucumber-report",
    "accessibility:test": "cypress run --env TAGS=\"@accessibility\"",
    "report:cucumber": "node cucumber-report.js",
    "accessibility": "npm run clean:reports && npm run accessibility:test && npm run report:cucumber"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "axe-core": "^4.11.4",
    "axe-html-reporter": "^2.2.11",
    "cypress": "^15.14.2",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "esbuild": "^0.28.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "rimraf": "^6.1.3"
  }
}
